# Vorlage für die API-Schlüssel der Skripte 07 und 09.
#
# Kopiere diese Datei nach api-keys.env (im selben Ordner) und trage dort deine
# Schlüssel ein. api-keys.env ist in .gitignore eingetragen und wird nie
# committet; diese Vorlage enthält keine Schlüssel und darf im Repository liegen.
#
# Die Skripte lesen die Datei mit tm.load_api_keys(). Ein Eintrag hier hat Vorrang
# vor einer gleichnamigen Umgebungsvariablen; ein neuer Schlüssel gilt, sobald die
# Zelle mit tm.load_api_keys() erneut ausgeführt wird.
# Leere Einträge werden ignoriert.

# Claude (Anthropic): https://platform.claude.com/
ANTHROPIC_API_KEY=

# Mistral: https://console.mistral.ai/
MISTRAL_API_KEY=
